# Copy to .env or pass with docker compose --env-file.
#
# Use calciforge:local when building from a repository checkout.
# For staging/release installs, use ghcr.io/bglusman/calciforge:main,
# ghcr.io/bglusman/calciforge:sha-<commit>, or a release version tag.
CALCIFORGE_IMAGE=calciforge:local
CALCIFORGE_DOCKER_BUILD_JOBS=1
CALCIFORGE_DOCKER_BUILD_PROFILE=docker
CALCIFORGE_CONFIG=./config.example.toml
CALCIFORGE_SECURITY_PROXY_CONFIG=./security-proxy.example.toml
CALCIFORGE_AGENTS_CONFIG=./agents.example.json
CALCIFORGE_CLASHD_POLICY=./policy.example.star
CALCIFORGE_DATA=./data
CALCIFORGE_SECURITY_PROXY_DATA=./data-security-proxy
CALCIFORGE_CLASHD_DATA=./data-clashd
CALCIFORGE_PROXY_PORT=18792
CALCIFORGE_SECURITY_PROXY_PORT=8888
CALCIFORGE_CLASHD_PORT=9001
# Published ports bind to loopback by default. Set to 0.0.0.0 only for intentional LAN exposure.
CALCIFORGE_HOST_BIND=127.0.0.1
RUST_LOG=calciforge=info,security_proxy=info,clashd=info
